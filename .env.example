# Copiá este archivo como .env al deployar en Portainer
# y completá los valores reales.

# Conexión a PostgreSQL con pgvector
# Si Postgres corre en otro contenedor Docker, reemplazá "localhost"
# por el nombre del contenedor (ej: postgres) o la IP de la Raspberry.
DATABASE_URL=postgresql://usuario:password@host:5432/dictamenes

# OpenAI
OPENAI_API_KEY=sk-proj-...

# Modelo para query expansion y reranking (opcional, default: gpt-4o-mini)
RERANK_MODEL=gpt-4o-mini
